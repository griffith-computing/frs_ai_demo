{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/griffith-computing/frs_ai_demo/benchmark/schemas/spec.schema.json",
  "title": "Face benchmark specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmarkVersion",
    "name",
    "tolerancePercentagePoints",
    "targets",
    "evaluationIdentities",
    "calibrationIdentities",
    "generator",
    "referenceModels"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "benchmarkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "tolerancePercentagePoints": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "evaluationIdentities": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/identity" }
    },
    "calibrationIdentities": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/identity" }
    },
    "generator": { "$ref": "#/$defs/model" },
    "referenceModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "recognizer"],
      "properties": {
        "detector": { "$ref": "#/$defs/model" },
        "recognizer": { "$ref": "#/$defs/model" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityId", "seed"],
      "properties": {
        "identityId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 },
        "modelUrl": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "modelSha256": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string" }
      }
    }
  }
}
