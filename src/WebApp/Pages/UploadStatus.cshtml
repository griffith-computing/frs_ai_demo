@page "{id}"
@model UploadStatusModel
@{
    ViewData["Title"] = "Upload status";
}

<section class="status-panel" data-upload-id="@Model.Upload.Id" data-status="@Model.Upload.Status">
    <p class="eyebrow">Upload accepted</p>
    <h1>Analysis <span id="status">@Model.Upload.Status</span></h1>
    <p class="mono">@Model.Upload.Id</p>
    <div class="progress-track" aria-hidden="true"><span></span></div>
    <p id="status-detail">@(Model.Upload.Status == "NoFaces"
        ? "No face data observed"
        : Model.Upload.FailureSummary ?? "The processing service will update this page automatically.")</p>
    <div class="status-actions">
        <a class="button secondary" asp-page="/Upload">Upload another</a>
        <a class="button" asp-page="/Index">Browse results</a>
    </div>
</section>

@section Scripts {
<script>
const panel = document.querySelector('.status-panel');
const terminal = new Set(['Completed', 'NoFaces', 'Failed']);
async function refreshStatus() {
    if (terminal.has(panel.dataset.status)) return;
    const response = await fetch(`?handler=State`, { headers: { 'Accept': 'application/json' } });
    if (!response.ok) return;
    const state = await response.json();
    panel.dataset.status = state.status;
    document.getElementById('status').textContent = state.status;
    document.getElementById('status-detail').textContent = state.status === 'NoFaces'
        ? 'No face data observed'
        : state.failureSummary ||
            (state.detectedFaceCount == null ? 'Analysis is in progress.' : `${state.detectedFaceCount} face(s) detected.`);
    if (!terminal.has(state.status)) window.setTimeout(refreshStatus, 2000);
}
window.setTimeout(refreshStatus, 2000);
</script>
}