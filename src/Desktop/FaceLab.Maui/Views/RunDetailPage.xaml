<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FaceLab.Maui.Views.RunDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FaceLab.Maui.Controls"
    xmlns:data="clr-namespace:FaceLab.Core.Data;assembly=FaceLab.Core"
    xmlns:overlay="clr-namespace:FaceLab.Maui.ViewModels"
    xmlns:vm="clr-namespace:FaceLab.Maui.ViewModels"
    x:DataType="vm:RunDetailViewModel"
    Title="Run detail">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label FontSize="20" FontAttributes="Bold" Text="{Binding Headline}" />
            <Label IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" Text="{Binding StatusMessage}" TextColor="Firebrick" />

            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding RerunCommand}" Text="Re-run with current configuration" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <controls:FaceOverlayView
                Faces="{Binding FaceOverlays}"
                HeightRequest="260"
                HorizontalOptions="Start"
                ImageBytes="{Binding Run.Image.Bytes}" />

            <Label FontSize="16" FontAttributes="Bold" Text="Faces" />
            <CollectionView ItemsSource="{Binding FaceOverlays}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="overlay:FaceOverlayItem">
                        <Border Margin="0,4" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="2">
                                <Label FontAttributes="Bold" Text="{Binding Record.Outcome}" />
                                <Label FontFamily="Consolas" FontSize="12" Text="{Binding Record.FaceId, StringFormat='faceId: {0}'}" />
                                <Label FontSize="12" Text="{Binding PersonLabel}" />
                                <Label FontSize="12" Text="{Binding Record.Confidence, StringFormat='Confidence: {0:F3}'}" />
                                <Label FontSize="12" Text="{Binding Record.ErrorMessage}" TextColor="Firebrick" />
                                <HorizontalStackLayout Spacing="16">
                                    <HorizontalStackLayout Spacing="6">
                                        <CheckBox IsChecked="{Binding ShowRectangle}" />
                                        <Label Text="Face rectangle" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <CheckBox IsChecked="{Binding ShowLandmarks}" IsEnabled="{Binding HasLandmarks}" />
                                        <Label Text="Face landmarks" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                                <Button
                                    HorizontalOptions="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RunDetailViewModel}}, Path=ShowDebugInfoCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Debug info" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontSize="16" FontAttributes="Bold" Text="Raw Face API calls" />
            <CollectionView ItemsSource="{Binding Traces}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:CallTraceRecord">
                        <Border Margin="0,4" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="2">
                                <Label FontAttributes="Bold" Text="{Binding Operation}" />
                                <Label FontFamily="Consolas" FontSize="12" Text="{Binding Url}" />
                                <Label FontSize="12" Text="{Binding StatusCode, StringFormat='HTTP {0}'}" />
                                <Label FontSize="12" Text="{Binding ElapsedMs, StringFormat='Elapsed: {0} ms'}" />
                                <Label FontFamily="Consolas" FontSize="11" Text="{Binding RequestSummary}" />
                                <Editor
                                    AutoSize="TextChanges"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    IsReadOnly="True"
                                    Text="{Binding ResponseBody}" />
                                <Label FontSize="12" Text="{Binding Error}" TextColor="Firebrick" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontSize="16" FontAttributes="Bold" Text="Configuration used for this run" />
            <Editor
                AutoSize="TextChanges"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                Text="{Binding ConfigSnapshot}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
