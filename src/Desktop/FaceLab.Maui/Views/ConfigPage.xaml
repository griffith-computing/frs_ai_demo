<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FaceLab.Maui.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:FaceLab.Core.Data;assembly=FaceLab.Core"
    xmlns:vm="clr-namespace:FaceLab.Maui.ViewModels"
    x:DataType="vm:ConfigViewModel"
    Title="Configuration">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label FontSize="20" FontAttributes="Bold" Text="Face API settings under test" />
            <Label
                FontSize="12"
                TextColor="Gray"
                Text="These values are used verbatim for every run. Nothing is deployed - the app calls the Face API directly." />

            <Label Text="Endpoint" />
            <Entry Placeholder="https://my-face.cognitiveservices.azure.com" Text="{Binding Options.Endpoint}" />

            <Label Text="Authentication mode" />
            <Picker ItemsSource="{Binding AuthModes}" SelectedItem="{Binding SelectedAuthMode}" />

            <Label IsVisible="{Binding IsKeyAuth}" Text="Subscription key (stored in Windows secure storage, never in the local database)" />
            <Entry IsPassword="True" IsVisible="{Binding IsKeyAuth}" Text="{Binding Options.SubscriptionKey}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="API version segment" />
                <Label Grid.Row="0" Grid.Column="1" Text="Dynamic person group id" />
                <Entry Grid.Row="1" Grid.Column="0" Text="{Binding Options.ApiVersionSegment}" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Options.DynamicPersonGroupId}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Detection model" />
                <Label Grid.Row="2" Grid.Column="1" Text="Recognition model" />
                <Entry Grid.Row="3" Grid.Column="0" Text="{Binding Options.DetectionModel}" />
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Options.RecognitionModel}" />

                <Label Grid.Row="4" Grid.Column="0" Text="Confidence threshold (0-1)" />
                <Label Grid.Row="4" Grid.Column="1" Text="Max candidates returned" />
                <Entry Grid.Row="5" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.ConfidenceThreshold}" />
                <Entry Grid.Row="5" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.MaxCandidatesReturned}" />

                <Label Grid.Row="6" Grid.Column="0" Text="Operation timeout (seconds)" />
                <Label Grid.Row="6" Grid.Column="1" Text="Operation poll interval (ms)" />
                <Entry Grid.Row="7" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.OperationTimeoutSeconds}" />
                <Entry Grid.Row="7" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.OperationPollIntervalMilliseconds}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Identify batch size (1-10)" />
                <Label Grid.Row="0" Grid.Column="1" Text="Max image size (bytes)" />
                <Entry Grid.Row="1" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.IdentifyBatchSize}" />
                <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.MaxImageSizeBytes}" />
            </Grid>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding Options.AutoEnrollUnmatchedFaces}" />
                <Label VerticalOptions="Center" Text="Automate provisional enrollment (writes to the real person directory; promotion is delayed)" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding Options.EnsureDynamicPersonGroupExists}" />
                <Label VerticalOptions="Center" Text="Ensure the dynamic person group exists before each run" />
            </HorizontalStackLayout>

            <Label FontSize="18" FontAttributes="Bold" Text="Automated enrollment safety policy" />
            <Label
                FontSize="12"
                TextColor="Gray"
                Text="A first qualifying capture creates a provisional Person Directory entry outside the dynamic group. Distinct qualifying captures promote it automatically." />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Required recognition quality" />
                <Label Grid.Row="0" Grid.Column="1" Text="Minimum face size (pixels)" />
                <Entry Grid.Row="1" Grid.Column="0" Text="{Binding Options.RequiredEnrollmentQuality}" />
                <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.MinimumEnrollmentFaceSizePixels}" />

                <Label Grid.Row="2" Grid.Column="0" Text="Required distinct images" />
                <Label Grid.Row="2" Grid.Column="1" Text="Provisional expiry (days)" />
                <Entry Grid.Row="3" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.RequiredEnrollmentImages}" />
                <Entry Grid.Row="3" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.ProvisionalExpirationDays}" />

                <Label Grid.Row="4" Grid.Column="0" Text="Provisional verification threshold" />
                <Label Grid.Row="4" Grid.Column="1" Text="Candidate confidence margin" />
                <Entry Grid.Row="5" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.ProvisionalVerificationThreshold}" />
                <Entry Grid.Row="5" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.CandidateConfidenceMargin}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Maximum yaw (degrees)" />
                <Label Grid.Row="0" Grid.Column="1" Text="Maximum pitch (degrees)" />
                <Label Grid.Row="0" Grid.Column="2" Text="Maximum roll (degrees)" />
                <Entry Grid.Row="1" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.MaximumEnrollmentYawDegrees}" />
                <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.MaximumEnrollmentPitchDegrees}" />
                <Entry Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Text="{Binding Options.MaximumEnrollmentRollDegrees}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Image-edge margin (pixels)" />
                <Label Grid.Row="0" Grid.Column="1" Text="Template learning threshold" />
                <Label Grid.Row="0" Grid.Column="2" Text="Maximum managed templates" />
                <Entry Grid.Row="1" Grid.Column="0" Keyboard="Numeric" Text="{Binding Options.EnrollmentEdgeMarginPixels}" />
                <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding Options.TemplateLearningThreshold}" />
                <Entry Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Text="{Binding Options.MaximumManagedFaceTemplates}" />
            </Grid>

            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding SaveCommand}" Text="Save configuration" />
                <Button Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Text="Test connection" />
                <Button Command="{Binding ResetToDefaultsCommand}" Text="Reset to defaults" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label FontSize="18" FontAttributes="Bold" Text="Saved configuration profiles" />
            <Label FontSize="12" TextColor="Gray" Text="Profiles never contain the subscription key." />

            <Entry Placeholder="Profile name, for example 'detection_03 + threshold 0.8'" Text="{Binding ProfileName}" />
            <Picker
                ItemDisplayBinding="{Binding Name, x:DataType=data:ConfigProfile}"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                Title="Select a saved profile" />

            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding SaveProfileCommand}" Text="Save profile" />
                <Button Command="{Binding ApplyProfileCommand}" Text="Apply profile" />
                <Button Command="{Binding DeleteProfileCommand}" Text="Delete profile" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label FontSize="18" FontAttributes="Bold" Text="Local database" />
            <Label FontSize="12" TextColor="Gray" Text="{Binding DatabasePath, StringFormat='SQLite file: {0}'}" />
            <Button Command="{Binding ResetDatabaseCommand}" HorizontalOptions="Start" Text="Reset local database" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label FontAttributes="Bold" Text="{Binding StatusMessage}" />
            <Editor
                AutoSize="TextChanges"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                IsVisible="{Binding TraceDetail, Converter={StaticResource StringNotEmpty}}"
                Text="{Binding TraceDetail}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
