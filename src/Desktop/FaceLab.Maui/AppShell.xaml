<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FaceLab.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FaceLab.Maui.Views"
    Title="Face Lab">

    <TabBar>
        <ShellContent
            Title="Configuration"
            ContentTemplate="{DataTemplate views:ConfigPage}"
            Route="config" />
        <ShellContent
            Title="Upload and run"
            ContentTemplate="{DataTemplate views:UploadPage}"
            Route="upload" />
        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="history" />
        <ShellContent
            Title="People"
            ContentTemplate="{DataTemplate views:PeoplePage}"
            Route="people" />
    </TabBar>

</Shell>
