{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "IDENTITY_ENDPOINT": "",
    "IMDS_ENDPOINT": "",

    "PhotosStorageAccountName": "<storage-account-name>",
    "PhotosContainerName": "photos",

    "EventHub__fullyQualifiedNamespace": "<namespace>.servicebus.windows.net",
    "EventHubName": "photo-events",
    "EventHubConsumerGroup": "process-photo-function",

    "CosmosDb__Endpoint": "https://<cosmos-account>.documents.azure.com:443/",
    "CosmosDb__DatabaseName": "FacialRecognitionDb",
    "CosmosDb__FacesContainerName": "Faces",

    "FaceApi__Endpoint": "https://<face-account>.cognitiveservices.azure.com/",
    "FaceApi__PersonGroupId": "frs-ai-demo-group",

    "AZURE_CLIENT_ID": "<user-assigned-identity-client-id-or-blank-for-local-dev>"
  }
}
