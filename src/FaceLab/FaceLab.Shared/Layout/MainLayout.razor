@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">FL</div>
            <div>
                <strong>FaceLab</strong>
                <span>Azure-hosted test bench</span>
            </div>
        </div>

        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="configure">Configuration</NavLink>
            <NavLink href="run">Upload and run</NavLink>
            <NavLink href="history">History</NavLink>
            <NavLink href="people">People</NavLink>
        </nav>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
